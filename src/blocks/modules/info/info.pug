mixin work-item(name)
  li.work__item
    a.work__item-link(href='#')&attributes(attributes)= name

section(aria-label='My works').info
  article.work
    a(href='#').work__link
      h3.work__title Musea
      +svg('icon-arrow').work__svg
    div.work__container
      +img('./img/image', 'My design').work__img
      ul.work__list
        +work-item('Elara').link.link_work
        +work-item('Verve').link.link_work
        +work-item('Zephyr').link.link_work
  ul(aria-label='My social').social
    +link('Instagram')
    +link('Twitter')
    +link('Linkedin')